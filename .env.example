# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# arXiv Categories
ARXIV_CATEGORIES=cs.LG,cs.CL,cs.AI

# Tokenization
VOCAB_SIZE=32000

# Training
BATCH_SIZE=8
LEARNING_RATE=1e-4

# W&B (optional)
WANDB_PROJECT=arxiv-llm-training
WANDB_ENABLED=false